# Copy to backend/.env and fill in. Never commit the real .env file.
GEMINI_API_KEY=your-api-key-here
GEMMA_MODEL=gemma-4-26b-a4b-it
# Gemma 4 thinking level. MINIMAL keeps analysis fast; leave empty to send no thinking setting.
GEMMA_THINKING_LEVEL=MINIMAL
# Seconds before a model call is abandoned (the request then fails closed).
MODEL_TIMEOUT_SECONDS=20
# SQLite file for policies and audit events (relative to backend/).
DATABASE_PATH=toolfence.db
# Comma-separated origins allowed by CORS during local development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Requests that can reach the model: per client per minute, and across all clients per hour. 0 disables.
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=200
